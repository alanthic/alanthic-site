<!doctype html>
<html lang="{{ page.lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ titulo }}</title>
<meta name="description" content="{{ descripcion }}">
<meta name="theme-color" content="#EDECE7">
{%- if noindex %}
<meta name="robots" content="noindex">
{%- endif %}
<link rel="canonical" href="{{ sitio.url }}{{ page.url }}">
{%- for alt in alternas %}
<link rel="alternate" hreflang="{{ alt.lang }}" href="{{ sitio.url }}{{ alt.url }}">
{%- endfor %}
<link rel="alternate" hreflang="x-default" href="{{ sitio.url }}{{ xDefault }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="Alanthic">
<meta property="og:title" content="{{ titulo }}">
<meta property="og:description" content="{{ descripcion }}">
<meta property="og:url" content="{{ sitio.url }}{{ page.url }}">
<meta property="og:locale" content="{{ 'es_CO' if page.lang == 'es' else 'en_US' }}">
<meta property="og:image" content="{{ sitio.url }}/og-{{ page.lang }}.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content="{{ ogAlt }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="preload" href="/fonts/schibsted-grotesk-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/css/sitio.css">
{%- if jsonld %}
<script type="application/ld+json">{{ jsonld | dump | safe }}</script>
{%- endif %}
</head>
<body>
{{ content | safe }}
<script src="/js/casa.js" defer></script>
</body>
</html>
